generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MARKET_DATABASE_URL")
}

model Purchase {
  id               String   @id @default(uuid())
  ingredient       String
  quantityReceived Int
  requestedAt      DateTime @default(now())
  success          Boolean
}
