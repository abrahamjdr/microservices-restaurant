# Database
DATABASE_URL=postgresql://restaurant_user:restaurant_pass@localhost:5432/restaurant

# Per-service database URLs (schema isolation)
KITCHEN_DATABASE_URL=postgresql://restaurant_user:restaurant_pass@postgres:5432/restaurant?schema=kitchen
WAREHOUSE_DATABASE_URL=postgresql://restaurant_user:restaurant_pass@postgres:5432/restaurant?schema=warehouse
MARKET_DATABASE_URL=postgresql://restaurant_user:restaurant_pass@postgres:5432/restaurant?schema=market

# Postgres container credentials
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_pass
POSTGRES_DB=restaurant

# Service URLs (internal docker network)
KITCHEN_SERVICE_URL=http://kitchen-service:8001
WAREHOUSE_SERVICE_URL=http://warehouse-service:8002
MARKET_SERVICE_URL=http://market-service:8003
AI_SERVICE_URL=http://ai-service:8004

# External APIs
FARMERS_MARKET_API_URL=https://recruitment.alegra.com/api/farmers-market/buy
OPENAI_API_KEY=sk-your-openai-api-key-here

# AWS (only needed for ai-service Lambda deployment)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Service Ports
API_GATEWAY_PORT=8000
KITCHEN_PORT=8001
WAREHOUSE_PORT=8002
MARKET_PORT=8003
AI_PORT=8004
FRONTEND_PORT=3000

# Environment
NODE_ENV=development
