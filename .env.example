# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# docker-compose reads .env automatically for variable substitution AND
# passes it to every container via env_file (required: false — safe to omit).
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_pass
POSTGRES_DB=restaurant

# ── External APIs ─────────────────────────────────────────────────────────────
# Required for ai-service (recipe recommendations)
OPENAI_API_KEY=sk-your-openai-api-key-here

FARMERS_MARKET_API_URL=https://recruitment.alegra.com/api/farmers-market/buy

# ── AWS — only needed for ai-service Lambda deployment (not local Docker) ─────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
