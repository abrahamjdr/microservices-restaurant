# cp .env.prod.example .env   (on the VM) and replace every <placeholder>.

# Postgres (internal only; never exposed)
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=restaurant

# Public API hostname served by Caddy (auto HTTPS).
# No domain? Use sslip.io with the VM public IP, dots -> dashes:
#   203.0.113.10 -> 203-0-113-10.sslip.io
API_DOMAIN=<ip-with-dashes>.sslip.io

# Optional: without it warehouse falls back to FallbackAnalyzer
OPENAI_API_KEY=

FARMERS_MARKET_API_URL=https://recruitment.alegra.com/api/farmers-market/buy
